{
  "name": "antifraud-ica-node-ts",
  "version": "0.1.0",
  "description": "Neutral authoritative identity credential provider service",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
